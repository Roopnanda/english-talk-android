<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <!-- Top Header Bar -->
    <RelativeLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="English Talk"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnVip"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="#F59E0B"
            android:text="👑 GO VIP"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Bottom AdMob Banner Container -->
    <FrameLayout
        android:id="@+id/layoutBannerAd"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_alignParentBottom="true"
        android:background="#1E293B" />

    <!-- Diagnostics Console Box -->
    <TextView
        android:id="@+id/tvConsoleLogs"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_above="@id/layoutBannerAd"
        android:background="#090D16"
        android:fontFamily="monospace"
        android:padding="6dp"
        android:scrollbars="vertical"
        android:textColor="#38BDF8"
        android:textSize="10sp" />

    <!-- 1. DASHBOARD VIEW -->
    <LinearLayout
        android:id="@+id/layoutDashboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/tvConsoleLogs"
        android:layout_below="@id/layoutHeader"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Select Level to Start Call"
            android:textColor="#94A3B8"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnBeginner"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="16dp"
            android:background="#2563EB"
            android:text="BEGINNER (TAP TO CALL)"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAdvanced"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="20dp"
            android:background="#1E293B"
            android:text="🔒 ADVANCED"
            android:textColor="#94A3B8"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp"
            android:background="#1E293B"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="👩 Talk to Female Gender 👑 VIP"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/switchFemaleFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <Button
            android:id="@+id/btnReconnectLast"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="#059669"
            android:text="🔄 Reconnect to the Last Caller"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvLockProgressPopup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#1E293B"
            android:gravity="center"
            android:padding="12dp"
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 2. SEARCHING VIEW -->
    <LinearLayout
        android:id="@+id/layoutSearching"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/tvConsoleLogs"
        android:layout_below="@id/layoutHeader"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="64dp"
            android:layout_height="64dp" />

        <TextView
            android:id="@+id/tvSearchingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Searching for a conversation partner..."
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnCancelSearch"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="32dp"
            android:background="#EF4444"
            android:text="CANCEL SEARCH"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 3. ACTIVE CALL VIEW -->
    <LinearLayout
        android:id="@+id/layoutCall"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/tvConsoleLogs"
        android:layout_below="@id/layoutHeader"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvCallPartnerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connected"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCallTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="15:00"
            android:textColor="#38BDF8"
            android:textSize="32sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMute"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginEnd="16dp"
                android:background="#334155"
                android:text="🎤"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnSpeaker"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginEnd="16dp"
                android:background="#334155"
                android:text="🔈"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnEndCall"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="#EF4444"
                android:text="📞"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
