<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <!-- 1. DASHBOARD CONTAINER -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/layoutDashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header Row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="English Talk"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvTalkCoinsBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#1E293B"
                        android:paddingStart="12dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="6dp"
                        android:text="🪙 Talk Coins: 0"
                        android:textColor="#FBBF24"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnVip"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="#CA8A04"
                        android:minWidth="0dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="👑 GO VIP"
                        android:textColor="#000000"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Metrics Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="#1E293B"
                android:orientation="horizontal"
                android:padding="16dp"
                android:weightSum="3">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStreakVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔥 0"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Day Streak"
                        android:textColor="#94A3B8"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTotalMinutesVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⏱️ 0m"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Practiced"
                        android:textColor="#94A3B8"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTotalCallsVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📞 0"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Calls"
                        android:textColor="#94A3B8"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Beginner Level Button -->
            <Button
                android:id="@+id/btnBeginner"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="14dp"
                android:backgroundTint="#16A34A"
                android:text="BEGINNER (TAP TO CALL)"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Advanced Level Button -->
            <Button
                android:id="@+id/btnAdvanced"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="6dp"
                android:backgroundTint="#334155"
                android:text="🔒 ADVANCED (0/20)"
                android:textColor="#94A3B8"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLockProgressPopup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:gravity="center"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Regional Languages Button -->
            <Button
                android:id="@+id/btnOtherLanguages"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="14dp"
                android:backgroundTint="#7C3AED"
                android:text="🌐 OTHER LANGUAGES"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Native Share Button -->
            <Button
                android:id="@+id/btnShareApp"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="14dp"
                android:backgroundTint="#0D9488"
                android:text="📢 SHARE APP WITH FRIENDS"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Female Filter Switch -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="14dp"
                android:background="#1E293B"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Talk to Female Only (VIP)"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <Switch
                    android:id="@+id/switchFemaleFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Reconnect to Last Caller -->
            <Button
                android:id="@+id/btnReconnectLast"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="10dp"
                android:backgroundTint="#E11D48"
                android:text="🔄 RECONNECT TO LAST CALLER"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Dedicated Dashboard Report Button -->
            <Button
                android:id="@+id/btnDashboardReportLast"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="#475569"
                android:text="⚠️ REPORT LAST CALLER"
                android:textColor="#FCA5A5"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Diagnostic Console -->
            <TextView
                android:id="@+id/tvConsoleLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#050811"
                android:padding="12dp"
                android:text="Tap to view diagnostic trace..."
                android:textColor="#38BDF8"
                android:textSize="11sp" />

        </LinearLayout>
    </ScrollView>

    <!-- 2. REGIONAL LANGUAGES SELECTION CONTAINER -->
    <ScrollView
        android:id="@+id/layoutLanguages"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0F172A"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <Button
                android:id="@+id/btnBackFromLanguages"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:backgroundTint="#334155"
                android:text="← BACK TO ENGLISH"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnWatchAdReward"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="20dp"
                android:backgroundTint="#EAB308"
                android:text="🎁 WATCH AD (+2 COINS)"
                android:textColor="#000000"
                android:textStyle="bold" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:useDefaultMargins="true">

                <Button android:id="@+id/btnLangHindi" android:layout_width="0dp" android:layout_columnWeight="1" android:text="HINDI" android:backgroundTint="#1E293B" android:textColor="#FFFFFF" />
                <Button android:id="@+id/btnLangPunjabi" android:layout_width="0dp" android:layout_columnWeight="1" android:text="PUNJABI" android:backgroundTint="#1E293B" android:textColor="#FFFFFF" />
                <Button android:id="@+id/btnLangMarathi" android:layout_width="0dp" android:layout_columnWeight="1" android:text="MARATHI" android:backgroundTint="#1E293B" android:textColor="#FFFFFF" />
                <Button android:id="@+id/btnLangBengali" android:layout_width="0dp" android:layout_columnWeight="1" android:text="BENGALI" android:backgroundTint="#1E293B" android:textColor="#FFFFFF" />
                <Button android:id="@+id/btnLangBhojpuri" android:layout_width="0dp" android:layout_columnWeight="1" android:text="BHOJPURI" android:backgroundTint="#1E293B" android:textColor="#FFFFFF" />
                <Button android:id="@+id/btnLangGujarati" android:layout_width="0dp" android:layout_columnWeight="1" android:text="GUJARATI" android:backgroundTint="#1E293B" android:textColor="#FFFFFF" />
                <Button android:id="@+id/btnLangKannada" android:layout_width="0dp" android:layout_columnWeight="1" android:text="KANNADA" android:backgroundTint="#1E293B" android:textColor="#FFFFFF" />
                <Button android:id="@+id/btnLangMalayalam" android:layout_width="0dp" android:layout_columnWeight="1" android:text="MALAYALAM" android:backgroundTint="#1E293B" android:textColor="#FFFFFF" />
                <Button android:id="@+id/btnLangTamil" android:layout_width="0dp" android:layout_columnWeight="1" android:text="TAMIL" android:backgroundTint="#1E293B" android:textColor="#FFFFFF" />
                <Button android:id="@+id/btnLangTelugu" android:layout_width="0dp" android:layout_columnWeight="1" android:text="TELUGU" android:backgroundTint="#1E293B" android:textColor="#FFFFFF" />
                <Button android:id="@+id/btnLangUrdu" android:layout_width="0dp" android:layout_columnWeight="1" android:text="URDU" android:backgroundTint="#1E293B" android:textColor="#FFFFFF" />
                <Button android:id="@+id/btnLangArabic" android:layout_width="0dp" android:layout_columnWeight="1" android:text="ARABIC" android:backgroundTint="#1E293B" android:textColor="#FFFFFF" />
            </GridLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 3. SEARCHING RADAR CONTAINER -->
    <LinearLayout
        android:id="@+id/layoutSearching"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0F172A"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:indeterminateTint="#38BDF8" />

        <TextView
            android:id="@+id/tvSearchingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="32dp"
            android:text="Searching for a partner..."
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnCancelSearch"
            android:layout_width="200dp"
            android:layout_height="50dp"
            android:backgroundTint="#E11D48"
            android:text="CANCEL"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 4. ACTIVE CALL CONTAINER -->
    <RelativeLayout
        android:id="@+id/layoutCall"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#090D16"
        android:padding="24dp"
        android:visibility="gone">

        <!-- Top In-Call Female Flag Button (Shown only during female filter calls) -->
        <Button
            android:id="@+id/btnInCallReport"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:backgroundTint="#334155"
            android:padding="0dp"
            android:text="⚐"
            android:textColor="#EF4444"
            android:textSize="20sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCallPartnerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connected"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCallTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="00:00"
                android:textColor="#38BDF8"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Call Control Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMute"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginEnd="16dp"
                android:backgroundTint="#1E293B"
                android:text="🎤"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btnSpeaker"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginEnd="16dp"
                android:backgroundTint="#1E293B"
                android:text="🔈"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btnEndCall"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:backgroundTint="#DC2626"
                android:text="📞"
                android:textSize="22sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Bottom Banner Container -->
    <FrameLayout
        android:id="@+id/layoutBannerAd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />

</FrameLayout>
